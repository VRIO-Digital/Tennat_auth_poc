# Copy to .env and fill in. Never commit the real .env.

# development | production
ENVIRONMENT=development

# Postgres (async URL is fine, the app maps it to psycopg)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/app

# JWT signing key. REQUIRED in production (the app refuses to start with the
# default). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
VERIFICATION_EXPIRE_MINUTES=30

# Workspaces are served at {URL_SCHEME}://{slug}.{BASE_DOMAIN}
BASE_DOMAIN=localhost:5173
URL_SCHEME=http

# Public URL of this API
API_BASE_URL=http://localhost:8000

# Allowed browser origins (comma-separated). Tenant subdomains of BASE_DOMAIN
# are allowed automatically; override with CORS_ORIGIN_REGEX if needed.
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=

# Return the email-verification link in the /register response.
# Defaults to true in development and false in production.
# EXPOSE_VERIFICATION_URL=false

# ---- Production (Render) ----
# Set these in the Render service's Environment tab, not in a committed file.
# ENVIRONMENT=production
# DATABASE_URL=<Render Postgres internal URL; postgres:// is accepted>
# SECRET_KEY=<64+ random chars>
# BASE_DOMAIN=tennat.vriodigital.ai
# URL_SCHEME=https
# API_BASE_URL=https://tennat-auth-poc.onrender.com
# CORS_ORIGINS=https://tennat.vriodigital.ai
